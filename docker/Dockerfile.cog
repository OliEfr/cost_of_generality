# Isaac Sim 5.1.0 + Isaac Lab v2.3.0 + LeRobot 0.4.4 + the cog package, for CLUSTER-SIDE eval.
#
# Why a container at all: Leonardo runs RHEL 8.8 with glibc 2.28, and Isaac Sim 5.1 needs
# >= 2.35, so the local recipe (pip install isaacsim into a conda env) cannot work there. And
# because `singularity build --fakeroot` is unmapped for our account, the image cannot be built
# on the cluster either -- it must arrive prebuilt. Hence: build here, `docker save`, rsync the
# archive, and `singularity build ... docker-archive://` on the login node (a pure format
# conversion, which needs no fakeroot).
#
#   docker build -f docker/Dockerfile.cog -t cog-isaaclab:5.1.0 .
#   docker save cog-isaaclab:5.1.0 -o <scratch>/cog-isaaclab.tar
#
# Build this ONLY after the base-image A100 render gate (slurm/debug_a100_kit.sbatch) passes:
# Isaac Sim is officially unsupported on A100 (no RT cores), and if it cannot render there is
# nothing for this image to do.
FROM nvcr.io/nvidia/isaac-sim:5.1.0

SHELL ["/bin/bash", "-c"]
ENV OMNI_KIT_ACCEPT_EULA=YES
ENV ISAACLAB_PATH=/workspace/isaaclab
ENV COG_PATH=/workspace/cog
# Compute nodes have no internet (CLAUDE.md rule 4); bake the offline switches into the image
# so a forgotten export cannot cause a job to hang on a hub call until it times out.
ENV HF_HUB_OFFLINE=1
ENV WANDB_MODE=offline
ENV TOKENIZERS_PARALLELISM=false

# IsaacLab's own Dockerfile.base installs these to build its extensions.
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake build-essential ncurses-term git \
    && rm -rf /var/lib/apt/lists/*

# Isaac Lab expects Isaac Sim to be reachable as <isaaclab>/_isaac_sim; the container ships it
# at /isaac-sim, so symlink rather than copy (a copy would double ~15 GB).
COPY third_party/IsaacLab ${ISAACLAB_PATH}
RUN ln -sf /isaac-sim ${ISAACLAB_PATH}/_isaac_sim \
    && cd ${ISAACLAB_PATH} \
    && ./isaaclab.sh --install none

# LeRobot goes into KIT's python (/isaac-sim/python.sh), not a system python -- the eval process
# imports Isaac and the policy in ONE interpreter, which is the whole reason LeRobot is pinned to
# a py3.11-compatible release (G1b / PINS). numpy is held at 1.26.4 because numpy 2.x segfaults
# Kit via the pinocchio ABI (D3).
RUN /isaac-sim/python.sh -m pip install --no-cache-dir "lerobot==0.4.4" "numpy==1.26.4"

COPY . ${COG_PATH}
RUN /isaac-sim/python.sh -m pip install --no-cache-dir -e ${COG_PATH}

# Assert the three imports the eval path needs, at BUILD time. Kit exits 0 after fatal errors
# (D6), so discovering a broken import inside a queued cluster job would be needlessly late.
RUN /isaac-sim/python.sh -c "\
import isaacsim, lerobot; \
print('isaacsim', isaacsim.__version__ if hasattr(isaacsim,'__version__') else 'ok'); \
print('lerobot', lerobot.__version__); \
import isaaclab; print('isaaclab ok'); \
import cog; print('cog ok')"

WORKDIR ${COG_PATH}
