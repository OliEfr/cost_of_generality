# Isaac Sim 5.1.0 + Isaac Lab v2.3.0 + LeRobot 0.4.4 + the cog package, for CLUSTER-SIDE eval.
#
# Why a container at all: Leonardo runs RHEL 8.8 with glibc 2.28 and Isaac Sim 5.1 needs >= 2.35,
# so the local recipe (pip install isaacsim into a conda env) cannot work there. And because
# `singularity build --fakeroot` is unmapped for our account, the image cannot be built on the
# cluster either -- it must arrive prebuilt. Route: build here, `docker save`, rsync the archive,
# `singularity build ... docker-archive://` on a compute node (a pure format conversion, no
# fakeroot needed).
#
#   docker build -f docker/Dockerfile.cog -t cog-isaaclab:5.1.0 .
#   docker save cog-isaaclab:5.1.0 -o <scratch>/cog-isaaclab.tar
FROM nvcr.io/nvidia/isaac-sim:5.1.0

SHELL ["/bin/bash", "-c"]
# The isaac-sim image's default USER is `isaac-sim`, not root, so every RUN below would run
# unprivileged -- apt-get fails with "List directory /var/lib/apt/lists/partial is missing -
# Permission denied" (exit 100). Docker's usual root default does not apply to this base image.
# Switching to root is safe for our purposes: Singularity ignores the image USER entirely and runs
# as the invoking user, so this affects only what the BUILD can write, not what the container runs as.
USER root
ENV OMNI_KIT_ACCEPT_EULA=YES
ENV ISAACLAB_PATH=/workspace/isaaclab
ENV COG_PATH=/workspace/cog
# Compute nodes have no internet (CLAUDE.md rule 4); bake the offline switches in so a forgotten
# export cannot hang a job on a hub call until it times out.
ENV HF_HUB_OFFLINE=1
ENV WANDB_MODE=offline
ENV TOKENIZERS_PARALLELISM=false

# THE FIX THAT MADE THIS IMAGE USABLE UNDER SINGULARITY (found 2026-08-19 by G5b stage A):
# /isaac-sim is `drwxr-x--- isaac-sim isaac-sim` (mode 750). Docker runs as root by default so
# nobody notices, but Singularity runs as the INVOKING user, so every path under /isaac-sim became
# unreadable -- `singularity exec ... /isaac-sim/python.sh` exited **126** ("found but not
# executable") and NVIDIA's own compatibility_check.sh said "Permission denied". That looks
# exactly like an Isaac-on-A100 failure and is nothing of the kind.
# The repair is tiny because the tree is otherwise sane: exactly ONE directory lacks o+x and only
# 28 entries lack o+r, so this touches ~29 files instead of copying up 15 GB of layer.
RUN chmod a+rx /isaac-sim \
 && find /isaac-sim ! -perm -o+r -print0 | xargs -0 -r chmod a+rX \
 && test -x /isaac-sim/python.sh \
 && echo "isaac-sim tree is now world-readable"

# IsaacLab's own Dockerfile.base installs these to build its extensions.
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake build-essential ncurses-term git \
    && rm -rf /var/lib/apt/lists/*

# Isaac Lab expects Isaac Sim at <isaaclab>/_isaac_sim; the container ships it at /isaac-sim, so
# symlink rather than copy (a copy would duplicate ~15 GB).
COPY third_party/IsaacLab ${ISAACLAB_PATH}
RUN ln -sf /isaac-sim ${ISAACLAB_PATH}/_isaac_sim \
 && cd ${ISAACLAB_PATH} \
 && ./isaaclab.sh --install none

# LeRobot goes into KIT's python (/isaac-sim/python.sh), not a system python -- eval imports Isaac
# and the policy in ONE interpreter, which is the whole reason LeRobot is pinned to a
# py3.11-compatible release (G1b / PINS).
#
# Two things measured in the base image, both of which simplify this step:
#   * it already ships **torch 2.7.0+cu128 / torchvision 0.22.0+cu128** -- byte-for-byte our
#     training pins (D22), so cluster-eval/train parity is automatic and torch is NOT reinstalled.
#   * it already ships **numpy 1.26.0**, i.e. numpy 1.x, so D3's "numpy 2.x segfaults Kit" hazard
#     is already avoided. Forcing `numpy==1.26.4` here would perturb isaacsim's own pinned tree
#     for no benefit, and it is what made the resolver fail: pip reported
#     "Cannot install imageio[ffmpeg]==2.37.0 and lerobot==0.4.4" even though imageio 2.37.0
#     satisfies lerobot's >=2.34,<3 -- a resolver artifact of an exactly-pinned EXTRA variant
#     being re-resolved. Constraining numpy loosely (<2) and restating the installed
#     imageio[ffmpeg] pin keeps the resolution stable.
# numpy is deliberately NOT constrained here. Stating `numpy<2` as a requirement made pip
# re-resolve everything that depends on numpy and it began backtracking through `datasets` and
# `accelerate` version by version (1.13.0 -> 1.12.0 -> ...), which is unbounded in practice. The
# installed numpy 1.26.0 already satisfies D3; pip leaves an installed package alone unless a
# dependency demands otherwise, so the correct move is to let it be and ASSERT afterwards -- if
# something does drag in numpy 2.x, the assert below fails the build loudly instead of shipping a
# Kit that segfaults at eval time.
RUN /isaac-sim/python.sh -m pip install --no-cache-dir \
        "lerobot==0.4.4" "imageio[ffmpeg]==2.37.0" \
 && /isaac-sim/python.sh -c "import numpy, torch; \
        assert numpy.__version__.startswith('1.'), numpy.__version__; \
        assert torch.__version__.startswith('2.7.0'), torch.__version__; \
        print('numpy', numpy.__version__, '| torch', torch.__version__)"

# Copy only what eval needs. NOT the whole repo: third_party/IsaacLab is already installed above
# and would otherwise be duplicated, and data/ is 121 GB (see .dockerignore).
COPY pyproject.toml README.md ${COG_PATH}/
COPY src ${COG_PATH}/src
COPY configs ${COG_PATH}/configs
COPY scripts ${COG_PATH}/scripts
RUN /isaac-sim/python.sh -m pip install --no-cache-dir -e ${COG_PATH}

# Assert every import the eval path needs, at BUILD time. Kit exits 0 after fatal errors (D6), so
# discovering a broken import inside a queued cluster job would be needlessly late.
RUN /isaac-sim/python.sh -c "\
import lerobot, numpy; \
print('lerobot', lerobot.__version__, '| numpy', numpy.__version__); \
import isaaclab; print('isaaclab ok'); \
import cog; print('cog ok')"

# Final permission sweep. The build above runs as root with umask 022, so new files are already
# world-readable, but pip/setuptools occasionally writes 600 files and Singularity would hit
# exactly the mode-750 class of failure again -- silently, at eval time. Cheap insurance, and it
# ASSERTS afterwards so the image cannot ship broken.
RUN find /isaac-sim /workspace ! -perm -o+r -print0 2>/dev/null | xargs -0 -r chmod a+rX; \
    n=$(find /isaac-sim /workspace ! -perm -o+r 2>/dev/null | wc -l); \
    echo "non-world-readable entries remaining: ${n}"; \
    test "${n}" -eq 0

WORKDIR ${COG_PATH}
