data/
third_party/
outputs/
wandb/
*.hdf5
*.sif
__pycache__/
*.pyc
.ipynb_checkpoints/
ops/*.log
*.egg-info/

# nested logs (the bare ops/*.log glob misses subdirectories)
ops/**/*.log
# local debug frame dumps
ops/t2_debug/
# large training weights: checkpoints live on disk / on the cluster, never in git
experiments/runs/**/*.safetensors
# local pre-push safety backups
data/_prepush_backup/
experiments/runs/

# gate scratch: G6 slice partials pulled for analysis, and the check_levels verdict file
ops/g6/
ops/check_levels.txt

# D31 sweep intermediates. Both are strictly recoverable from what IS committed, and this sweep is
# ~30x the size of the L3 one whose partials were tracked (results/_l3_partials, 320 files):
#   _partials/      per-slice eval JSONs -- the pooled result concatenates every episode outcome
#                   and records the slice in per_variant/per_batch, so nothing is lost
#   _evalsets_raw/  per-sub-level snapshots -- merge_eval_sets copies each one verbatim into the
#                   frozen configs/eval_sets/*.json, which are committed and never regenerated
results/_partials/
results/_evalsets_raw/

# Hourly-watcher state. These files exist so alerts fire on TRANSITIONS rather than on state
# (see docs/running_jobs.md); they are per-machine bookkeeping, not results, and committing them
# would make a fresh checkout re-announce every job that has ever finished.
ops/.failed_seen
ops/status_d31.state
ops/status_d31.log
